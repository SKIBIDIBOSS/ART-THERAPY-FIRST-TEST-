generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
 url      = env("DATABASE_URL")
}

model User {
 id            String   @id @default(cuid())
 firstName     String
 lastName      String
 email         String   @unique

 banned        Boolean  @default(false)
 banReason     String?

 createdAt     DateTime @default(now())

 sessions      Session[]
 surveys       Survey[]
}

model Session {
 id          String   @id @default(cuid())
 userId      String
 user        User     @relation(fields:[userId], references:[id])

 createdAt   DateTime @default(now())
}

model Survey {
 id            String @id @default(cuid())

 userId        String
 user          User @relation(fields:[userId], references:[id])

 beforeStress  Int
 afterStress   Int

 notes         String?

 createdAt     DateTime @default(now())
}
